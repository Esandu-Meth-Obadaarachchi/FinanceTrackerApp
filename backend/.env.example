# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Primary provider: Gemini Flash (free tier) ──────────────────────────
# Both the "AIzaSy..." and "AQ...." key formats go in the x-goog-api-key
# header. Set GEMINI_AUTH_STYLE=oauth only for a real OAuth bearer token.
GEMINI_API_KEY=
GEMINI_AUTH_STYLE=api_key
GEMINI_MODEL=gemini-3.6-flash

# ── Fallback provider: Claude Haiku ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Server ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:8567,https://fintrack-esandu-010357.netlify.app

# Shared secret the Flutter client sends as X-App-Key. Leave blank to
# disable the check (local development only — never in production, or the
# endpoint becomes an open proxy that burns your API credits).
APP_SHARED_KEY=
